```env
# Samsung AI Troubleshooter — environment variables
# Copy to .env and fill in. NEVER commit real secrets. .env is gitignored.

# Your own LLM provider key (server-side only, never exposed to the browser).
LLM_API_KEY=your_openrouter_api_key

# Any OpenAI-compatible chat completions endpoint.
# OpenAI:   https://api.openai.com/v1
# Groq:     https://api.groq.com/openai/v1
# Together: https://api.together.xyz/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model id served by the endpoint above.
LLM_MODEL=google/gemma-4-26b-a4b-it:free
